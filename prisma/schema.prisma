generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tag {
  id     String   @id @default(cuid())
  label  String   @unique
  color  String
  players Player[]
}

model Player {
  id        String   @id @default(cuid())
  name      String   @unique
  stakes    String?
  notes     String
  tagId     String?
  tag       Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}